# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/schoolos"

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ─── SMS — SMSGateHub ─────────────────────────────────────────────────────────
# Get your API key from: https://smsgatehub.com/dashboard
# Register a DLT-approved Sender ID for transactional SMS (required in India)
SMSGATEHUB_API_KEY=""
SMSGATEHUB_SENDER_ID="SUNACM"    # 6-char DLT registered header

# ─── Meta (WhatsApp Cloud API — Tech Provider / Embedded Signup) ─────────────
# Platform-level credentials for the SchoolOS Tech Provider account
# Permanent System User Token — generate in Business Manager → System Users
META_SYSTEM_USER_TOKEN=""
# App credentials — developers.facebook.com → Your App → Settings → Basic
META_APP_ID=""
META_APP_SECRET=""
# Embedded Signup Config ID — App Dashboard → WhatsApp → Configuration
META_CONFIG_ID=""

# ─── Zoom — Server-to-Server OAuth ──────────────────────────────────────────
# Setup steps:
# 1. Go to https://marketplace.zoom.us/develop/create
# 2. Create a "Server-to-Server OAuth" app (not General OAuth)
# 3. Add scopes: meeting:write:meeting, meeting:read:meeting
# 4. Activate the app and copy the credentials below
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# ─── Google Meet — Service Account ──────────────────────────────────────────
# Setup steps:
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "Google Calendar API"
# 3. IAM & Admin → Service Accounts → Create service account
# 4. Create a JSON key → download it
# 5. Share your Google Calendar with the service account email (Editor access)
# 6. Copy values from the downloaded JSON file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=""   # "client_email" from JSON key file
GOOGLE_PRIVATE_KEY=""             # "private_key" from JSON — keep \n as literals
GOOGLE_CALENDAR_ID="primary"      # or specific calendar ID like "abc123@group.calendar.google.com"
