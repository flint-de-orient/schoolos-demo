  razorpayOrderId String?
  placedAt    DateTime @default(now())
  deliveredAt DateTime?
  notes       String?

  items ShopOrderItem[]

  @@index([tenantId])
  @@index([studentId])
}

model ShopOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  size      String?
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  order   ShopOrder   @relation(fields: [orderId], references: [id])
  product ShopProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─────────────────────────────────────────────
// INTERVIEW SCHEDULING MODULE
// ─────────────────────────────────────────────

enum InterviewMode {
  PHYSICAL
  ZOOM
  GMEET
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  RESCHEDULED
  CANCELLED
}

enum InterviewRecommendation {
  ADMIT
  WAITLIST
  REJECT
  HOLD
}

model InterviewSchedule {
  id               String                  @id @default(cuid())
  tenantId         String
  inquiryId        String                  @unique
  date             DateTime                @db.Date
  startTime        String                  // "10:00"
  endTime          String                  // "10:15"
  duration         Int                     @default(15)
  mode             InterviewMode           @default(PHYSICAL)
  roomOrLink       String?                 // room no OR meeting join URL
  meetingId        String?                 // Zoom meeting ID / Google event ID
  meetingPasscode  String?
  interviewerName  String?
  queueNo          Int                     @default(1)
  status           InterviewStatus         @default(SCHEDULED)
  parentNotified   Boolean                 @default(false)
  feedback         String?
  recommendation   InterviewRecommendation?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  inquiry AdmissionInquiry @relation(fields: [inquiryId], references: [id])

  @@index([tenantId])
  @@index([date])
}

// Per-tenant configurable slot settings
model InterviewSlotConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  workingDays     Int[]    // ISO weekday: 1=Mon … 6=Sat, 7=Sun
  morningStart    String   @default("09:00")
  morningEnd      String   @default("13:00")
  afternoonStart  String   @default("14:00")
  afternoonEnd    String   @default("17:00")
  defaultDuration Int      @default(15)
  maxConcurrent   Int      @default(1) // interviews at the same time slot
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  blockedDates InterviewBlockedDate[]
}

// Dates blocked for interviews (holidays, staff leave, etc.)
model InterviewBlockedDate {
  id       String   @id @default(cuid())
  configId String
  date     DateTime @db.Date
  reason   String?

  config InterviewSlotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, date])
  @@index([configId])
}

// Per-tenant API integration credentials (Zoom, Google Meet, SMS, WhatsApp)
// Sensitive fields (secrets, private keys) are stored in the `secrets` JSON column
// and are NEVER returned to the client — only masked status is shown.
model TenantIntegrationConfig {
  id        String   @id @default(cuid())
  tenantId  String
  provider  String   // 'zoom' | 'gmeet' | 'smsgatehub' | 'whatsapp'
  enabled   Boolean  @default(false)
  // Non-sensitive visible config (e.g. sender ID, calendar ID, account ID)
  config    Json     @default("{}")
  // Sensitive secrets — never returned to client
  secrets   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
  @@index([tenantId])
}
