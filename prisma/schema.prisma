generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// SECTION 0 — ENUMS
// ─────────────────────────────────────────────

enum Board {
  CBSE
  CISCE
  WBBSE
  OTHER
}

enum ModuleId {
  dashboard
  students
  admissions
  attendance
  timetable
  academics
  exam_engine
  examinations
  fee
  library
  transport
  health
  hr
  parent_portal
  parent_app
  school_shop
  ai_advisor
  analytics
  settings
  id_cards
  certificates
  gate
  chatbot
  communication
  accounts
  scholarships
  ptm
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  TEACHER
  LIBRARIAN
  NURSE
  ACCOUNTANT
  TRANSPORT_MANAGER
  PARENT
  STUDENT
}

enum TeacherType {
  FULL_TIME
  PART_TIME
  NON_TEACHING
  CONTRACT
}

enum SubjectProficiency {
  PRIMARY
  SECONDARY
  SUBSTITUTE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimetableStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
  LEAVE
}

enum AttendanceSource {
  MANUAL
  GATE_RFID
  GATE_FACE
}

enum GateEventType {
  ENTRY
  EXIT
  BUS_BOARDING
  BUS_ALIGHTING
}

enum DeviceType {
  UHF_RFID
  HF_RFID
  FACE_CAM
}

enum GateNotifyChannel {
  WHATSAPP
  SMS
  BOTH
  NONE
}

enum GateNotifyTrigger {
  ENTRY
  EXIT
  BOTH
  NONE
}

enum CertificateType {
  TRANSFER
  BONAFIDE
  CHARACTER
  CONDUCT
  MIGRATION
  LEAVING
  SCHOLARSHIP
  ACHIEVEMENT
  SPORTS
  NCC
  SCOUT
  PARTICIPATION
  MERIT
  MEDICAL_FIT
  EMPLOYMENT_VERIFY
}

enum AIJobType {
  TIMETABLE_GENERATE
  FEE_DEFAULT_PREDICT
  BOARD_SCORE_PREDICT
  LEARNING_PLAN_GEN
  WEAK_TOPIC_DETECT
  SUBSTITUTE_SUGGEST
  ADMISSION_FUNNEL
  ANALYTICS_SNAPSHOT
  CERTIFICATE_DRAFT
  COMMUNICATION_DRAFT
}

enum AIJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum Language {
  en
  bn
  hi
  ur
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
  PARTIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdmissionStage {
  INQUIRY
  APPLICATION_RECEIVED
  DOCUMENTS_VERIFIED
  INTERVIEW_SCHEDULED
  OFFER_MADE
  ENROLLED
  REJECTED
}

enum AdmissionSource {
  WALK_IN
  SCHOOL_WEBSITE
  REFERRAL
  CAMPAIGN
  SOCIAL_MEDIA
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SUCCESS
}

enum MessageStatus {
  SENT
  FAILED
  DELIVERED
  READ
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum TransactionMode {
  CASH
  UPI
  NEFT
  CHEQUE
  DD
  CARD
  RAZORPAY
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  BI_MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum ConcessionType {
  PERCENTAGE
  FLAT_AMOUNT
}

enum ConcessionApplicability {
  ALL_COMPONENTS
  SPECIFIC_COMPONENTS
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

enum PTMBookingStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────────────────────
// SECTION 1 — CORE: TENANT + USER
// ─────────────────────────────────────────────

model Tenant {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  shortName   String
  board       Board
  city        String
  state       String
  country     String  @default("India")
  phone       String?
  email       String  @unique
  website     String?
  address     String?
  logoUrl     String?
  headTitle   String  @default("Principal")
  headName    String
  timezone    String  @default("Asia/Kolkata")
  locale      Language @default(en)
  isActive      Boolean @default(true)
  isOnboarded   Boolean @default(false)
  trialEndsAt   DateTime?
  plan        String  @default("growth")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  modules         TenantModule[]
  users           User[]
  academicYears   AcademicYear[]
  grades          Grade[]
  sections        Section[]
  subjects        Subject[]
  teachers        Teacher[]
  staff           Staff[]
  students        Student[]
  parents         Parent[]
  timetableConfigs TimetableConfig[]
  timetables      Timetable[]
  feeComponents       FeeComponent[]
  studentCategories   StudentCategory[]
  feePlans            FeePlan[]
  concessionTemplates ConcessionTemplate[]
  feeSettings         TenantFeeSettings?
  books               Book[]
  transportRoutes TransportRoute[]
  healthLogs      NurseLog[]
  certificates    Certificate[]
  idCards         IDCard[]
  aiJobs          AIJob[]
  notifications   Notification[]
  outboundLogs    OutboundLog[]
  auditLogs       AuditLog[]
  chatSessions    ChatSession[]
  schoolEvents    SchoolEvent[]
  communications  Communication[]
  ptmSessions     PTMSession[]
  gateDevices     GateDevice[]
  studentCards    StudentCard[]
  gateSettings    TenantGateSettings?
  biometricIntegrations BiometricIntegration[]
  interviewSchedules   InterviewSchedule[]
  interviewSlotConfig  InterviewSlotConfig?
  integrationConfigs   TenantIntegrationConfig[]
  salarySettings  TenantSalarySettings?
  salaryGrades    SalaryGrade[]
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  module    ModuleId
  isActive  Boolean  @default(true)
  config    Json?
  activatedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, module])
  @@index([tenantId])
}

model User {
  id            String   @id @default(cuid())
  tenantId      String
  email         String
  passwordHash  String
  role          UserRole
  displayName   String
  phone         String?
  avatarUrl     String?
  locale        Language @default(en)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  sessions     UserSession[]
  teacher      Teacher?
  staff        Staff?
  parent       Parent?
  student      Student?
  auditLogs    AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
}

// ─────────────────────────────────────────────
// SECTION 2 — SCHOOL STRUCTURE
// ─────────────────────────────────────────────

model AcademicYear {
  id         String   @id @default(cuid())
  tenantId   String
  label      String
  startDate  DateTime
  endDate    DateTime
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  grades      Grade[]
  sections    Section[]
  feePlans    FeePlan[]
  feeAssignments StudentFeeAssignment[]
  timetables  Timetable[]
  examSchedules ExamSchedule[]
  reportCards ReportCard[]

  @@unique([tenantId, label])
  @@index([tenantId])
}

model Grade {
  id             String   @id @default(cuid())
  tenantId       String
  academicYearId String
  name           String
  displayOrder   Int
  board          Board
  isExamClass    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  sections     Section[]
  gradeSubjects GradeSubject[]
  syllabi      Syllabus[]
  students     Student[]
  feeAccounts  FeeAccount[]
  feePlanGrades FeePlanGrade[]
  examScheduleItems ExamScheduleItem[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId])
}

model Section {
  id             String   @id @default(cuid())
  tenantId       String
  academicYearId String
  gradeId        String
  name           String
  classTeacherId String?
  roomNumber     String?
  strength       Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  grade          Grade        @relation(fields: [gradeId], references: [id])
  classTeacher   Teacher?     @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students       Student[]
  timetableEntries TimetableEntry[]
  attendanceSessions AttendanceSession[]

  @@unique([gradeId, name])
  @@index([tenantId])
  @@index([gradeId])
}

model Subject {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  nameLocal     String?
  code          String?
  colorHex      String?
  isElective    Boolean  @default(false)
  isLanguage    Boolean  @default(false)
  isPractical   Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  gradeSubjects  GradeSubject[]
  teacherSubjects TeacherSubject[]
  syllabi        Syllabus[]
  timetableEntries TimetableEntry[]
  markEntries    MarkEntry[]
  lessonPlans    LessonPlan[]
  homework       Homework[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model GradeSubject {
  id           String  @id @default(cuid())
  gradeId      String
  subjectId    String
  periodsPerWeek Int   @default(5)
  isCompulsory Boolean @default(true)
  maxMarks     Int     @default(100)
  passMarks    Int     @default(33)

  grade   Grade   @relation(fields: [gradeId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([gradeId, subjectId])
}

model Syllabus {
  id             String   @id @default(cuid())
  tenantId       String
  gradeId        String
  subjectId      String
  academicYearId String?
  board          Board
  totalTopics    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  grade    Grade    @relation(fields: [gradeId], references: [id])
  subject  Subject  @relation(fields: [subjectId], references: [id])
  chapters SyllabusChapter[]

  @@unique([gradeId, subjectId])
  @@index([tenantId])
}

model SyllabusChapter {
  id          String  @id @default(cuid())
  syllabusId  String
  chapterNo   Int
  title       String
  titleLocal  String?
  topics      SyllabusTopic[]
  completions ChapterCompletion[]

  syllabus Syllabus @relation(fields: [syllabusId], references: [id])

  @@unique([syllabusId, chapterNo])
}

model SyllabusTopic {
  id          String  @id @default(cuid())
  chapterId   String
  topicNo     Int
  title       String
  titleLocal  String?
  isCompleted Boolean @default(false)

  chapter SyllabusChapter @relation(fields: [chapterId], references: [id])

  @@unique([chapterId, topicNo])
}

model ChapterCompletion {
  id          String   @id @default(cuid())
  chapterId   String
  sectionId   String
  teacherId   String
  completedOn DateTime
  remarks     String?
  createdAt   DateTime @default(now())

  chapter SyllabusChapter @relation(fields: [chapterId], references: [id])
}

// ─────────────────────────────────────────────
// SECTION 3 — TEACHERS & STAFF
// ─────────────────────────────────────────────

model Teacher {
  id              String      @id @default(cuid())
  tenantId        String
  userId          String?     @unique
  employeeCode    String
  name            String
  phone           String?
  email           String?
  type            TeacherType
  designation     String?
  department      String?
  qualification   String?
  joiningDate     DateTime?
  dateOfBirth     DateTime?
  gender          Gender?
  avatarUrl       String?
  biometricId     String?
  isActive        Boolean     @default(true)
  maxPeriodsDay   Int         @default(6)
  maxPeriodsWeek  Int         @default(30)
  salary          Decimal?    @db.Decimal(12,2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  user             User?          @relation(fields: [userId], references: [id])
  subjects         TeacherSubject[]
  availabilities   TeacherAvailability[]
  availabilityOverrides TeacherAvailabilityOverride[]
  workloadSnapshots TeacherWorkloadSnapshot[]
  classTeacherOf   Section[]      @relation("ClassTeacher")
  timetableEntries TimetableEntry[]
  substitutionsGiven Substitution[] @relation("SubstituteTeacher")
  substitutionsTaken Substitution[] @relation("OriginalTeacher")
  lessonPlans      LessonPlan[]
  teachingPlans    TeachingPlan[]
  homework         Homework[]
  leaveRequests    LeaveRequest[]
  appraisals       StaffAppraisal[]
  cpdLogs          CPDLog[]
  ptmSlots         PTMSlot[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
}

model TeacherSubject {
  id           String             @id @default(cuid())
  teacherId    String
  subjectId    String
  proficiency  SubjectProficiency @default(PRIMARY)
  gradeIds     String[]

  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
}

model TeacherAvailability {
  id        String    @id @default(cuid())
  teacherId String
  day       DayOfWeek
  startTime String
  endTime   String
  isAvailable Boolean @default(true)

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, day, startTime])
}

model TeacherAvailabilityOverride {
  id        String   @id @default(cuid())
  teacherId String
  date      DateTime @db.Date
  isAvailable Boolean
  reason    String?
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
  @@index([teacherId])
}

model TeacherWorkloadSnapshot {
  id              String   @id @default(cuid())
  teacherId       String
  timetableId     String
  periodsPerWeek  Int
  subjectsCount   Int
  sectionsCount   Int
  createdAt       DateTime @default(now())

  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  timetable Timetable @relation(fields: [timetableId], references: [id])

  @@index([teacherId])
  @@index([timetableId])
}

model Staff {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String?   @unique
  employeeCode  String
  name          String
  designation   String
  department    String?
  phone         String?
  email         String?
  joiningDate   DateTime?
  salary        Decimal?  @db.Decimal(12, 2)
  biometricId   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  leaveRequests LeaveRequest[]
  payrolls Payroll[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// SECTION 4 — STUDENTS & PARENTS
// ─────────────────────────────────────────────

model Student {
  id                String    @id @default(cuid())
  tenantId          String
  userId            String?   @unique
  admissionNo       String
  rollNo            String?
  name              String
  dateOfBirth       DateTime? @db.Date
  gender            Gender?
  bloodGroup        BloodGroup?
  photoUrl          String?
  gradeId           String
  sectionId         String
  house             String?
  religion          String?
  category          String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  aadharNo          String?
  previousSchool    String?
  admissionDate     DateTime  @db.Date
  tcNumber          String?
  attendancePercent Float     @default(100)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  grade        Grade        @relation(fields: [gradeId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  parents      StudentParent[]
  medical      StudentMedical?
  documents    StudentDocument[]
  achievements StudentAchievement[]
  feeAccount   FeeAccount?
  attendanceRecords AttendanceRecord[]
  bookIssues   BookIssue[]
  gateEvents   GateEvent[]
  studentCards StudentCard[]
  markEntries  MarkEntry[]
  healthLogs   NurseLog[]
  idCard       IDCard?
  certificates Certificate[]
  behaviourLogs BehaviourLog[]
  counsellorNotes CounsellorNote[]
  homeworkSubmissions HomeworkSubmission[]
  routeAssignment StudentRouteAssignment?
  hallTickets  HallTicket[]
  learningPlans AILearningPlan[]
  weakTopicAlerts AIWeakTopicAlert[]
  boardPredictions AIBoardScorePrediction[]
  vaccinations     StudentVaccination[]
  feeAssignment    StudentFeeAssignment?

  @@unique([tenantId, admissionNo])
  @@index([tenantId])
  @@index([gradeId])
  @@index([sectionId])
}

model Parent {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?  @unique
  fatherName  String?
  motherName  String?
  guardianName String?
  phone       String
  altPhone    String?
  email       String?
  occupation  String?
  annualIncome String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  user     User?           @relation(fields: [userId], references: [id])
  children StudentParent[]
  devices  ParentDevice[]
  messages ParentTeacherMessage[]
  pickupOTPs ParentPickupOTP[]
  ptmBookings PTMBooking[]

  @@index([tenantId])
}

model StudentParent {
  id          String  @id @default(cuid())
  studentId   String
  parentId    String
  relation    String
  isPrimary   Boolean @default(false)
  hasAppAccess Boolean @default(true)

  student Student @relation(fields: [studentId], references: [id])
  parent  Parent  @relation(fields: [parentId], references: [id])

  @@unique([studentId, parentId])
}

model StudentMedical {
  id            String   @id @default(cuid())
  studentId     String   @unique
  bloodGroup    BloodGroup?
  height        Float?
  weight        Float?
  allergies     String[]
  conditions    String[]
  medications   String[]
  doctorName    String?
  doctorPhone   String?
  notes         String?
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

model StudentDocument {
  id          String   @id @default(cuid())
  studentId   String
  type        String
  fileUrl     String
  fileName    String
  uploadedAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model StudentAchievement {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  category    String?
  date        DateTime @db.Date
  description String?
  certificateUrl String?
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

// ─────────────────────────────────────────────
// SECTION 5 — TIMETABLE ENGINE
// ─────────────────────────────────────────────

model TimetableConfig {
  id                   String   @id @default(cuid())
  tenantId             String
  periodsPerDay        Int      @default(8)
  workingDays          DayOfWeek[]
  periodDuration       Int      @default(40)
  breakAfterPeriod     Int[]
  breakDuration        Int      @default(20)
  schoolStartTime      String   @default("08:00")
  maxConsecutivePeriods Int     @default(2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  periodSlots PeriodSlot[]

  @@unique([tenantId])
}

model PeriodSlot {
  id               String   @id @default(cuid())
  configId         String
  periodNo         Int
  startTime        String
  endTime          String
  isBreak          Boolean  @default(false)
  label            String?

  config TimetableConfig @relation(fields: [configId], references: [id])
  timetableEntries TimetableEntry[]

  @@unique([configId, periodNo])
}

model Timetable {
  id              String          @id @default(cuid())
  tenantId        String
  academicYearId  String
  label           String
  status          TimetableStatus @default(DRAFT)
  qualityScore    Int?
  conflictCount   Int             @default(0)
  generatedByAI   Boolean         @default(false)
  aiJobId         String?
  generatedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  entries      TimetableEntry[]
  substitutions Substitution[]
  workloadSnapshots TeacherWorkloadSnapshot[]

  @@index([tenantId])
}

model TimetableEntry {
  id           String    @id @default(cuid())
  timetableId  String
  sectionId    String
  subjectId    String
  teacherId    String
  periodSlotId String
  day          DayOfWeek
  roomNumber   String?
  isElective   Boolean   @default(false)

  timetable  Timetable  @relation(fields: [timetableId], references: [id])
  section    Section    @relation(fields: [sectionId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])
  teacher    Teacher    @relation(fields: [teacherId], references: [id])
  periodSlot PeriodSlot @relation(fields: [periodSlotId], references: [id])

  @@unique([timetableId, sectionId, day, periodSlotId])
  @@index([timetableId])
  @@index([teacherId])
  @@index([sectionId])
}

model Substitution {
  id              String    @id @default(cuid())
  timetableId     String
  timetableEntryId String?
  date            DateTime  @db.Date
  day             DayOfWeek
  sectionId       String
  subjectId       String
  originalTeacherId String
  substituteTeacherId String?
  periodSlotId    String
  reason          String?
  status          String    @default("PENDING")
  assignedByAI    Boolean   @default(false)
  aiScore         Float?
  notes           String?
  createdAt       DateTime  @default(now())

  timetable       Timetable @relation(fields: [timetableId], references: [id])
  originalTeacher Teacher   @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  substituteTeacher Teacher? @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])

  @@index([timetableId])
