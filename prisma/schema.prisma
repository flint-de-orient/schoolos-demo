// ─────────────────────────────────────────────
// SECTION 12 — TRANSPORT
// ─────────────────────────────────────────────

model TransportRoute {
  id          String  @id @default(cuid())
  tenantId    String
  routeName   String
  routeCode   String?
  vehicleId   String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  stops       RouteStop[]
  vehicle     TransportVehicle? @relation(fields: [vehicleId], references: [id])
  assignments StudentRouteAssignment[]
  tracking    VehicleTracking[]
  sosAlerts   SOSAlert[]

  @@index([tenantId])
}

model RouteStop {
  id          String @id @default(cuid())
  routeId     String
  stopName    String
  stopOrder   Int
  arrivalTime String?
  lat         Float?
  lng         Float?
  studentCount Int   @default(0)

  route  TransportRoute @relation(fields: [routeId], references: [id])

  @@unique([routeId, stopOrder])
}

model TransportVehicle {
  id           String  @id @default(cuid())
  tenantId     String
  vehicleNo    String
  type         String  @default("BUS")
  capacity     Int
  driverId     String?
  isActive     Boolean @default(true)
  insuranceExpiry DateTime? @db.Date
  fcExpiry     DateTime? @db.Date
  createdAt    DateTime @default(now())

  driver  VehicleDriver?   @relation(fields: [driverId], references: [id])
  routes  TransportRoute[]

  @@unique([tenantId, vehicleNo])
}

model VehicleDriver {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  phone       String
  licenseNo   String?
  licenseExpiry DateTime? @db.Date
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  vehicles TransportVehicle[]
}

model StudentRouteAssignment {
  id          String @id @default(cuid())
  studentId   String @unique
  routeId     String
  stopId      String?
  pickupType  String @default("BOTH")

  student Student        @relation(fields: [studentId], references: [id])
  route   TransportRoute @relation(fields: [routeId], references: [id])
}

model VehicleTracking {
  id        String   @id @default(cuid())
  routeId   String
  lat       Float
  lng       Float
  speed     Float?
  heading   Float?
  timestamp DateTime @default(now())

  route TransportRoute @relation(fields: [routeId], references: [id])

  @@index([routeId, timestamp])
}

model SOSAlert {
  id          String   @id @default(cuid())
  routeId     String
  triggeredAt DateTime @default(now())
  resolvedAt  DateTime?
  lat         Float?
  lng         Float?
  notes       String?
  status      String   @default("ACTIVE")

  route TransportRoute @relation(fields: [routeId], references: [id])

  @@index([routeId])
}

// ─────────────────────────────────────────────
// SECTION 13 — HEALTH
// ─────────────────────────────────────────────

model NurseLog {
  id               String   @id @default(cuid())
  tenantId         String
  studentId        String
  date             DateTime @db.Date
  time             String?
  complaint        String
  actionTaken      String?
  temperature      Float?
  referredToDoctor Boolean  @default(false)
  parentNotified   Boolean  @default(false)
  followUpRequired Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([tenantId, date])
  @@index([studentId])
}

model VaccinationDrive {
  id          String   @id @default(cuid())
  tenantId    String
  vaccineName String
  targetGrades String[]
  date        DateTime @db.Date
  agency      String?
  notes       String?
  createdAt   DateTime @default(now())

  vaccinations StudentVaccination[]

  @@index([tenantId])
}

model StudentVaccination {
  id         String   @id @default(cuid())
  studentId  String
  driveId    String?
  vaccine    String
  date       DateTime @db.Date
  batchNo    String?
  givenBy    String?
  parentConsent Boolean @default(true)
  createdAt  DateTime @default(now())

  student Student          @relation(fields: [studentId], references: [id])
  drive   VaccinationDrive? @relation(fields: [driveId], references: [id])

  @@index([studentId])
}

model HealthAlert {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String
  severity    String   @default("INFO")
  affectedCount Int    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// SECTION 14 — FEE MANAGEMENT
// ─────────────────────────────────────────────

// Tenant-level reusable charge definitions (e.g. Tuition, Library, Lab, Hostel)
model FeeComponent {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  isOptional   Boolean  @default(false)
  isRefundable Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  planItems FeePlanItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// School-defined student enrolment categories (fully flexible, no hardcoding)
model StudentCategory {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  feePlans    FeePlan[]
  feeAccounts FeeAccount[]
  assignments StudentFeeAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Fee Plan — scoped to academic year + optional student category + one or more grades
model FeePlan {
  id                String   @id @default(cuid())
  tenantId          String
  academicYearId    String
  name              String
  studentCategoryId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  academicYear    AcademicYear             @relation(fields: [academicYearId], references: [id])
  studentCategory StudentCategory?         @relation(fields: [studentCategoryId], references: [id])
  grades          FeePlanGrade[]
  items           FeePlanItem[]
  customSchedule  FeeCustomSchedule?
  assignments     StudentFeeAssignment[]
  accounts        FeeAccount[]

  @@index([tenantId])
}

// M2M: FeePlan ↔ Grade
model FeePlanGrade {
  id      String @id @default(cuid())
  planId  String
  gradeId String

  plan  FeePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  grade Grade   @relation(fields: [gradeId], references: [id])

  @@unique([planId, gradeId])
}

// Line items within a plan — component + per-occurrence amount + frequency
model FeePlanItem {
  id                    String       @id @default(cuid())
  planId                String
  componentId           String
  amount                Decimal      @db.Decimal(12, 2)
  frequency             FeeFrequency @default(ANNUAL)
  displayOrder          Int          @default(0)
  includeForNewAdmission Boolean     @default(true)

  plan         FeePlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  component    FeeComponent @relation(fields: [componentId], references: [id])
  installments FeeInstallment[]

  @@unique([planId, componentId])
  @@index([planId])
}

// Tenant-level default due day per frequency — set once, inherited by all plans
model TenantFeeSettings {
  id               String @id @default(cuid())
  tenantId         String @unique
  monthlyDueDay    Int    @default(10)
  biMonthlyDueDay  Int    @default(10)
  quarterlyDueDay  Int    @default(10)
  halfYearlyDueDay Int    @default(1)
  annualDueDay     Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// Optional custom payment schedule for a plan — overrides frequency-based defaults
model FeeCustomSchedule {
  id     String @id @default(cuid())
  planId String @unique

  plan         FeePlan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  installments FeeCustomInstallment[]
}

model FeeCustomInstallment {
  id           String  @id @default(cuid())
  scheduleId   String
  name         String
  percentage   Decimal @db.Decimal(6, 2)
  dueDay       Int
  dueMonth     Int
  displayOrder Int     @default(0)

  schedule FeeCustomSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

// Concession types — fully school-defined, not hardcoded
model ConcessionTemplate {
  id              String                  @id @default(cuid())
  tenantId        String
  name            String
  type            ConcessionType
  value           Decimal                 @db.Decimal(10, 2)
  applicableTo    ConcessionApplicability @default(ALL_COMPONENTS)
  componentIds    String[]
  isStackable     Boolean                 @default(false)
  maxAmount       Decimal?                @db.Decimal(10, 2)
  createdAt       DateTime                @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  concessions StudentConcession[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Student's fee plan assignment for an academic year
model StudentFeeAssignment {
  id                String   @id @default(cuid())
  tenantId          String
  studentId         String   @unique
  feePlanId         String
  academicYearId    String
  studentCategoryId String?
  assignedAt        DateTime @default(now())
  assignedBy        String?

  student         Student           @relation(fields: [studentId], references: [id])
  feePlan         FeePlan           @relation(fields: [feePlanId], references: [id])
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id])
  studentCategory StudentCategory?  @relation(fields: [studentCategoryId], references: [id])
  concessions     StudentConcession[]
  feeAccount      FeeAccount?

  @@unique([studentId, academicYearId])
  @@index([tenantId])
}

// Concessions applied to a specific student assignment
model StudentConcession {
  id                   String   @id @default(cuid())
  assignmentId         String
  concessionTemplateId String
  overrideAmount       Decimal? @db.Decimal(10, 2)
  reason               String?
  approvedBy           String?
  createdAt            DateTime @default(now())

  assignment         StudentFeeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  concessionTemplate ConcessionTemplate   @relation(fields: [concessionTemplateId], references: [id])

  @@unique([assignmentId, concessionTemplateId])
}

// ─── Fee Account & Transactions ───────────────────────────────────────────────

model FeeAccount {
  id                String    @id @default(cuid())
  tenantId          String
  studentId         String    @unique
  gradeId           String
  academicYearId    String
  feePlanId         String?
  assignmentId      String?   @unique
  studentCategoryId String?
  totalDue          Decimal   @db.Decimal(12, 2) @default(0)
  totalPaid         Decimal   @db.Decimal(12, 2) @default(0)
